<Window
    x:Class="GreenLuma_Manager.Dialogs.CustomMessageBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Message"
    Width="480"
    MinHeight="220"
    MaxHeight="600"
    Background="#FF1A1A1A"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BackgroundDark" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="BackgroundSurface" Color="#FF0F0F0F" />
            <SolidColorBrush x:Key="Border" Color="#FF2A2A2A" />
            <SolidColorBrush x:Key="Accent" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="Text" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#FFAAAAAA" />
            <!--  ReSharper disable once Xaml.RedundantResource  -->
            <SolidColorBrush x:Key="Success" Color="#FF4CAF50" />
            <!--  ReSharper disable once Xaml.RedundantResource  -->
            <SolidColorBrush x:Key="Warning" Color="#FFFFAA00" />
            <!--  ReSharper disable once Xaml.RedundantResource  -->
            <SolidColorBrush x:Key="Danger" Color="#FFFF4444" />
            <!--  ReSharper disable once Xaml.RedundantResource  -->
            <SolidColorBrush x:Key="Info" Color="#FF2196F3" />
            <Style x:Key="MessageButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource BackgroundDark}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFDDDDDD" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!--  ReSharper disable once Xaml.RedundantResource  -->
            <Style
                x:Key="SecondaryButton"
                BasedOn="{StaticResource MessageButton}"
                TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource BackgroundSurface}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF1E1E1E" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <CubicEase x:Key="DefaultEase" EasingMode="EaseOut" />
            <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid Margin="0,0,0,0" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    TextBlock.FontSize="14"
                                    TextBlock.FontWeight="Medium" />
                                <Border
                                    x:Name="Track"
                                    Grid.Column="1"
                                    Width="48"
                                    Height="26"
                                    CornerRadius="13">
                                    <Border.Background>
                                        <SolidColorBrush Color="#FF2A2A2A" />
                                    </Border.Background>
                                    <Grid>
                                        <Ellipse
                                            x:Name="Knob"
                                            Width="20"
                                            Height="20"
                                            Margin="3,0,0,0"
                                            HorizontalAlignment="Left">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="#FFAAAAAA" />
                                            </Ellipse.Fill>
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    EasingFunction="{StaticResource DefaultEase}"
                                                    Storyboard.TargetName="Track"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FFFFFFFF"
                                                    Duration="0:0:0.4" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                    To="#FF1A1A1A"
                                                    Duration="0:0:0.3" />
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource DefaultEase}"
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="22"
                                                    Duration="0:0:0.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetName="Track"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FF2A2A2A"
                                                    Duration="0:0:0.4" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                    To="#FFAAAAAA"
                                                    Duration="0:0:0.3" />
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource DefaultEase}"
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="0"
                                                    Duration="0:0:0.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Path
                        Name="IconPath"
                        Width="20"
                        Height="20"
                        Margin="0,0,12,0"
                        Stretch="Uniform" />
                    <TextBlock
                        Name="TitleText"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Text}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="24,20">
            <StackPanel>
                <TextBlock
                    Name="MessageText"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource TextSecondary}"
                    LineHeight="22"
                    TextWrapping="Wrap" />
                <CheckBox
                    x:Name="ChkRemember"
                    Margin="0,20,0,0"
                    Visibility="Collapsed"
                    Content="Remember my preference and don't ask me again"
                    Style="{StaticResource ToggleSwitch}" />
            </StackPanel>
        </Border>
        <Border
            Grid.Row="2"
            Padding="24,16"
            Background="{StaticResource BackgroundSurface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="0,1,0,0">
            <StackPanel
                Name="ButtonPanel"
                HorizontalAlignment="Right"
                Orientation="Horizontal" />
        </Border>
    </Grid>
</Window>